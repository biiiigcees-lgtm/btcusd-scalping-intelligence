{
  "name": "btc-scalping-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "BTCUSD AI Scalping Intelligence Assistant — non-executing quantitative research & decision-support platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @btc/db generate",
    "db:migrate": "pnpm --filter @btc/db migrate",
    "db:studio": "pnpm --filter @btc/db studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "next": "^15.0.0"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "20.x"
  }
}
