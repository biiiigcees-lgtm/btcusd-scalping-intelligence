# === Shared ===
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/btc

# === Worker ===
USE_MOCK_FEED=false
HEALTH_PORT=8081
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_US_WS_URL=wss://stream.binance.us:9443/ws/btcusdt@trade
FEED_FAILOVER_SILENCE_MS=8000

# === Web (Vercel) ===
# Redis must be reachable from Vercel (Upstash recommended)
# REDIS_URL=
DASHBOARD_SECRET=

# Web Push (optional) — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Telegram (optional, worker only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
